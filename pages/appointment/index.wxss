.appointment-page {
  padding-bottom: 64rpx;
}

.appointment-hero {
  position: relative;
  min-height: 380rpx;
  padding: 38rpx 34rpx 58rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #071a34 0%, #0d2c55 72%, #12456c 100%);
  box-sizing: border-box;
  box-shadow: 0 22rpx 54rpx rgba(7, 26, 52, .2);
  overflow: hidden;
}

.hero-orbit {
  position: absolute;
  border: 1rpx solid rgba(159, 230, 238, .18);
  border-radius: 50%;
}

.hero-orbit-large {
  top: -170rpx;
  right: -120rpx;
  width: 420rpx;
  height: 420rpx;
}

.hero-orbit-small {
  top: -42rpx;
  right: 12rpx;
  width: 210rpx;
  height: 210rpx;
}

.hero-eyebrow,
.hero-title,
.hero-summary,
.section-step,
.section-title,
.section-note,
.field-label,
.intent-eyebrow,
.intent-label,
.intent-value,
.submit-note {
  display: block;
}

.hero-eyebrow {
  position: relative;
  color: #ffd468;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  position: relative;
  width: 86%;
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.3;
}

.hero-summary {
  position: relative;
  width: 92%;
  margin-top: 18rpx;
  color: rgba(230, 239, 249, .76);
  font-size: 23rpx;
  line-height: 1.7;
}

.hero-benefits {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .18);
}

.benefit-item {
  position: relative;
  padding-left: 18rpx;
  color: rgba(255, 255, 255, .8);
  font-size: 20rpx;
  font-weight: 700;
}

.benefit-item + .benefit-item {
  margin-left: 28rpx;
}

.benefit-item::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #9fe6ee;
  content: "";
  transform: translateY(-50%);
}

.form-card {
  position: relative;
  z-index: 2;
  margin: 0 16rpx;
  margin-top: 0;
  padding: 34rpx 30rpx 36rpx;
  border: 1rpx solid rgba(10, 45, 103, .07);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 20rpx 54rpx rgba(18, 51, 92, .12);
}

.history-card {
  position: relative;
  z-index: 2;
  margin: -32rpx 28rpx 24rpx;
  padding: 34rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(7, 26, 52, 0.09);
}

.history-heading,
.history-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.history-heading .section-title {
  display: block;
  margin-top: 8rpx;
}

.history-count,
.history-meta,
.history-message,
.history-state {
  color: #7a879a;
  font-size: 24rpx;
}

.history-state {
  padding: 30rpx 0 6rpx;
  line-height: 1.6;
}

.history-error {
  color: #2b6f8a;
}

.appointment-history {
  margin-top: 24rpx;
}

.history-item {
  padding: 24rpx 0;
  border-top: 1rpx solid #e7edf4;
}

.history-intent {
  color: #0b2344;
  font-size: 28rpx;
  font-weight: 700;
}

.history-status {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #9b6a15;
  background: #fff3d8;
  font-size: 22rpx;
}

.status-converted,
.status-visited {
  color: #2f7a48;
  background: #e8f6ec;
}

.status-invalid {
  color: #768196;
  background: #eef1f5;
}

.history-meta,
.history-message {
  display: block;
  margin-top: 12rpx;
  line-height: 1.5;
}

.history-message {
  color: #536176;
}

.intent-card {
  margin-bottom: 34rpx;
  padding: 22rpx 24rpx;
  border-left: 5rpx solid #d3a747;
  background: #f7f4eb;
}

.intent-eyebrow {
  margin-bottom: 12rpx;
  color: #9a772c;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.intent-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.intent-row + .intent-row {
  margin-top: 8rpx;
}

.intent-label {
  color: #7d8793;
  font-size: 20rpx;
}

.intent-value {
  margin-left: 24rpx;
  color: #0b2a54;
  font-size: 22rpx;
  font-weight: 800;
  text-align: right;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.section-step {
  margin-bottom: 5rpx;
  color: #3d8495;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.section-title {
  color: #0b2a54;
  font-size: 31rpx;
  font-weight: 900;
}

.section-note {
  padding-bottom: 4rpx;
  color: #9aa6b5;
  font-size: 18rpx;
}

.field-group + .field-group {
  margin-top: 22rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #344b69;
  font-size: 21rpx;
  font-weight: 700;
}

.field-control {
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(10, 45, 103, .1);
  border-radius: 14rpx;
  background: #f4f7fa;
  box-sizing: border-box;
  color: #0b2a54;
  font-size: 24rpx;
}

.field-placeholder {
  color: #a7b1bd;
}

.field-textarea {
  height: 150rpx;
  padding-top: 22rpx;
  line-height: 1.55;
}

.section-divider {
  height: 1rpx;
  margin: 34rpx 0;
  background: #e9eef3;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  margin-top: 36rpx;
  padding: 0 30rpx;
  border-radius: 15rpx;
  background: #0b2a54;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 92rpx;
  letter-spacing: 1rpx;
}

.submit-button::after {
  border: 0;
}

.submit-arrow {
  color: #ffd468;
  font-size: 34rpx;
  font-weight: 400;
}

.submit-note {
  margin-top: 16rpx;
  color: #96a2b1;
  font-size: 18rpx;
  text-align: center;
}
