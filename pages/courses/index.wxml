<view class="page">
  <view class="courses-hero">
    <view class="hero-panel hero-panel-left">
      <image
        class="hero-image hero-image-programming"
        src="/assets/courses/programming-workshop-v1.jpg"
        mode="aspectFill"
      ></image>
    </view>
    <view class="hero-panel hero-panel-right">
      <image
        class="hero-image hero-image-interest"
        src="/assets/home/interest-workshop-v2.jpg"
        mode="aspectFill"
      ></image>
    </view>
    <view class="hero-shade"></view>
    <view class="hero-kicker">
      <text class="eyebrow">INTEREST / GROWTH</text>
      <text class="hero-mark">LINGZHI</text>
    </view>
    <text class="page-title">兴趣活动</text>
    <text class="page-summary">从真实体验出发，让孩子在表达、创造与文化活动中发现兴趣。</text>
    <view class="hero-footer">
      <text class="hero-caption">ACTIVITY DIRECTORY</text>
      <view class="hero-stat">
        <text class="hero-count">{{courses.length}}</text>
        <text class="hero-unit">个探索方向</text>
      </view>
    </view>
  </view>

  <view class="list-heading">
    <view>
      <text class="section-eyebrow">EXPLORE</text>
      <text class="list-title">探索方向</text>
    </view>
    <text class="list-note">从兴趣出发 · 向成长延伸</text>
  </view>

  <view
    class="course-card"
    wx:for="{{courses}}"
    wx:key="id"
    wx:for-index="courseIndex"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="course-visual">
      <image class="course-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="course-image-shade"></view>
      <text class="course-number">0{{courseIndex + 1}}</text>
    </view>
    <view class="course-content">
      <view class="course-card-head">
        <view class="course-title-wrap">
          <text class="course-title">{{item.title}}</text>
        </view>
        <view class="course-action">
          <text class="course-arrow">→</text>
        </view>
      </view>
      <text class="course-summary">{{item.summary}}</text>
      <view class="tag-row" wx:if="{{item.tags && item.tags.length}}">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card empty-state">
    <text class="empty-title">正在加载兴趣活动</text>
  </view>

  <view wx:elif="{{loadFailed}}" class="card empty-state">
    <text class="empty-title">活动加载失败</text>
    <text class="muted">请检查网络后重新加载。</text>
    <button class="retry-button" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{!courses.length}}" class="card empty-state">
    <text class="empty-title">敬请期待</text>
  </view>
</view>
