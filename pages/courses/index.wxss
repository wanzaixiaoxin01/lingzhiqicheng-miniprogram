.courses-intro {
  padding: 30rpx;
  background: linear-gradient(140deg, #f3f9ff, #ffffff 72%);
  border: 2rpx solid rgba(17, 104, 223, .08);
}

.eyebrow,
.page-title,
.page-summary,
.course-category,
.course-title,
.course-summary,
.list-title,
.list-count,
.empty-title {
  display: block;
}

.eyebrow {
  color: #227cc4;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 10rpx;
  color: #0a2d67;
  font-size: 42rpx;
  font-weight: 900;
}

.page-summary {
  margin-top: 12rpx;
  color: #66758a;
  font-size: 25rpx;
  line-height: 1.6;
}

.list-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 34rpx;
}

.list-title {
  color: #0a2d67;
  font-size: 32rpx;
  font-weight: 900;
}

.list-count {
  color: #8a9aae;
  font-size: 22rpx;
}

.course-card {
  position: relative;
  margin-top: 18rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(17, 104, 223, .08);
  overflow: hidden;
}

.course-card::before {
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, #1168df, #20b8d7);
  content: "";
}

.course-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-left: 8rpx;
}

.course-title-wrap {
  min-width: 0;
}

.course-category {
  color: #227cc4;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.course-title {
  margin-top: 7rpx;
  color: #102f5f;
  font-size: 31rpx;
  font-weight: 900;
}

.course-arrow {
  flex: 0 0 auto;
  margin-left: 20rpx;
  color: #1168df;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}

.course-summary {
  margin-top: 16rpx;
  padding-left: 8rpx;
  color: #66758a;
  font-size: 25rpx;
  line-height: 1.6;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-left: 8rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #edf7ff;
  color: #1168df;
  font-size: 21rpx;
}

.empty-state {
  margin-top: 20rpx;
  padding: 34rpx 28rpx;
  text-align: center;
}

.empty-title {
  color: #102f5f;
  font-size: 30rpx;
  font-weight: 900;
}

.muted {
  display: block;
  margin-top: 10rpx;
  color: #66758a;
  line-height: 1.6;
}
