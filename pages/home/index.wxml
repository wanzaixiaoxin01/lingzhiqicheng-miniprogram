<view class="home-page">
  <view class="hero-section">
    <image
      class="hero-image"
      src="../../assets/home/hero-space-ai-v2.jpg"
      mode="aspectFill"
    ></image>
    <view class="hero-shade"></view>
    <image
      class="hero-brand-logo"
      src="../../assets/lingzhi-logo-144.png"
      mode="aspectFit"
    ></image>
    <view class="hero-copy">
      <text class="hero-kicker">LINGZHI SERVICE MODEL</text>
      <text class="hero-title">学习空间</text>
      <text class="hero-title hero-title-accent">× 智能设备</text>
      <text class="hero-summary">灵智启程以学习空间为基础，提供智能学习设备体验，并通过高校参访、兴趣拓展和文化活动，帮助孩子发展爱好、开阔眼界。</text>
      <view class="hero-paths">
        <text>SPACE</text>
        <text>AI</text>
        <text>FIELD</text>
      </view>
    </view>
    <view class="hero-appointment-entry" bindtap="goAppointment">
      <text>预约到店体验</text>
      <text class="hero-appointment-arrow">→</text>
    </view>
  </view>

  <view class="content-shell">
    <view class="section-heading">
      <text class="section-kicker">WHAT WE OFFER</text>
      <text class="section-title">核心服务</text>
    </view>

    <view class="service-card">
      <image
        class="service-image"
        src="../../assets/home/learning-space-interior-v2.jpg"
        mode="aspectFill"
        lazy-load="true"
      ></image>
      <view class="service-copy">
        <text class="service-index">01 · SPACE</text>
        <text class="service-title">空间服务</text>
        <text class="service-summary">安静、稳定、有陪伴，让孩子愿意坐下来，专注完成作业、阅读、复盘与自主探索。</text>
        <view class="service-tags">
          <text>安静专注</text>
          <text>自主管理</text>
          <text>稳定陪伴</text>
        </view>
      </view>
    </view>

    <view class="service-card">
      <image
        class="service-image"
        src="../../assets/home/ai-device-scene-v2.jpg"
        mode="aspectFill"
        lazy-load="true"
      ></image>
      <view class="service-copy">
        <text class="service-index">02 · AI COMPANION</text>
        <text class="service-title">AI 学习机</text>
        <text class="service-summary">展示智能学习设备的功能与使用场景，提供配置咨询和到店体验。</text>
        <view class="service-tags">
          <text>设备展示</text>
          <text>功能体验</text>
          <text>配置咨询</text>
        </view>
      </view>
    </view>

    <view class="service-card">
      <image
        class="service-image"
        src="../../assets/home/interest-workshop-v2.jpg"
        mode="aspectFill"
        lazy-load="true"
      ></image>
      <view class="service-copy">
        <text class="service-index">03 · FIELD</text>
        <text class="service-title">兴趣活动</text>
        <text class="service-summary">从高校参访到多元文化活动，让孩子接触更丰富的人、事与真实场景。</text>
        <view class="service-tags">
          <text>高校参访</text>
          <text>兴趣活动</text>
          <text>真实场景</text>
        </view>
      </view>
    </view>

    <view class="shortcut-section">
      <view class="shortcut-heading">
        <text class="section-kicker">QUICK ACCESS</text>
        <text class="shortcut-title">热门服务</text>
      </view>
      <view class="shortcut-grid">
        <view
          wx:for="{{shortcuts}}"
          wx:key="label"
          class="shortcut-item"
          data-url="{{item.url}}"
          data-mode="{{item.mode}}"
          bindtap="goShortcut"
        >
          <text class="shortcut-mark">{{item.mark}}</text>
          <text class="shortcut-label">{{item.label}}</text>
          <text class="shortcut-arrow">↗</text>
        </view>
      </view>
    </view>

    <view class="appointment-section">
      <view class="appointment-orbit appointment-orbit-large"></view>
      <view class="appointment-orbit appointment-orbit-small"></view>
      <view class="appointment-copy">
        <text class="appointment-kicker">START HERE</text>
        <text class="appointment-title">预约到店体验</text>
        <text class="appointment-summary">到店了解学习空间与智能设备，获取适合的体验建议。</text>
      </view>
      <button class="appointment-cta" bindtap="goAppointment">立即预约</button>
    </view>
  </view>
</view>
