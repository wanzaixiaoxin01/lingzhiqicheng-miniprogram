.home-page {
  min-height: 100vh;
  overflow: hidden;
  background: #f6f8f7;
  color: #102f58;
}

.hero-section {
  position: relative;
  height: 780rpx;
  overflow: hidden;
  background: #061a3f;
}

.hero-image,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background:
    linear-gradient(180deg, rgba(4, 18, 43, .04) 0%, rgba(4, 18, 43, .2) 38%, rgba(4, 18, 43, .94) 100%),
    linear-gradient(90deg, rgba(4, 18, 43, .5), transparent 72%);
}

.hero-brand-logo {
  position: absolute;
  top: 28rpx;
  left: 42rpx;
  z-index: 2;
  box-sizing: border-box;
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid rgba(255, 255, 255, .72);
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 10rpx 28rpx rgba(1, 12, 31, .22);
}

.hero-copy {
  position: absolute;
  right: 42rpx;
  bottom: 54rpx;
  left: 42rpx;
  z-index: 1;
}

.hero-kicker,
.hero-title,
.hero-summary {
  display: block;
}

.hero-kicker {
  margin-bottom: 18rpx;
  color: #ffd06f;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  line-height: 1.05;
}

.hero-title-accent {
  margin-top: 8rpx;
  color: #a5edf0;
}

.hero-summary {
  max-width: 640rpx;
  margin-top: 24rpx;
  color: rgba(240, 248, 255, .78);
  font-size: 25rpx;
  line-height: 1.72;
}

.hero-paths {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .2);
}

.hero-paths text {
  margin-right: 42rpx;
  color: rgba(255, 255, 255, .66);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-paths text:nth-child(2) {
  color: #93dfe5;
}

.hero-paths text:nth-child(3) {
  color: #ffd06f;
}

.hero-appointment-entry {
  position: absolute;
  right: 42rpx;
  bottom: 32rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  height: 66rpx;
  padding-left: 28rpx;
  color: #ffd06f;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-appointment-arrow {
  margin-left: 12rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.content-shell {
  padding: 56rpx 26rpx 48rpx;
  padding-bottom: 240rpx;
}

.section-heading {
  padding: 0 10rpx 30rpx;
}

.section-kicker,
.section-title {
  display: block;
}

.section-kicker {
  color: #25818d;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.section-title {
  margin-top: 12rpx;
  color: #102f58;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.service-card {
  overflow: hidden;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(16, 47, 88, .06);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 54rpx rgba(16, 47, 88, .1);
}

.service-image {
  display: block;
  width: 100%;
  height: 374rpx;
  background: #dce7ee;
}

.service-copy {
  padding: 30rpx 30rpx 32rpx;
}

.service-index {
  display: block;
  color: #28838f;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.service-title {
  display: block;
  margin-top: 10rpx;
  color: #102f58;
  font-size: 38rpx;
  font-weight: 900;
}

.service-summary {
  display: block;
  margin-top: 14rpx;
  color: #617488;
  font-size: 25rpx;
  line-height: 1.45;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.service-tags text {
  margin: 0 12rpx 10rpx 0;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f4f2;
  color: #267783;
  font-size: 21rpx;
  font-weight: 700;
}

.shortcut-section {
  margin-top: 60rpx;
}

.shortcut-heading {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 10rpx 24rpx;
}

.shortcut-title {
  display: block;
}

.shortcut-title {
  margin-top: 10rpx;
  color: #102f58;
  font-size: 40rpx;
  font-weight: 900;
}

.shortcut-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14rpx;
}

.shortcut-item {
  position: relative;
  grid-column: span 2;
  min-height: 132rpx;
  padding: 22rpx 18rpx;
  border: 1rpx solid rgba(16, 47, 88, .08);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(16, 47, 88, .06);
}

.shortcut-item:nth-child(n+4) {
  grid-column: span 3;
}

.shortcut-mark,
.shortcut-label,
.shortcut-arrow {
  display: block;
}

.shortcut-mark {
  overflow: hidden;
  color: #2c8994;
  font-size: 15rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shortcut-label {
  margin-top: 18rpx;
  color: #102f58;
  font-size: 32rpx;
  font-weight: 800;
}

.shortcut-arrow {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  color: #b2c0cc;
  font-size: 22rpx;
}

.appointment-section {
  position: relative;
  overflow: hidden;
  margin-top: 34rpx;
  padding: 38rpx 32rpx 32rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #082650 0%, #0e5375 58%, #168895 100%);
  box-shadow: 0 22rpx 54rpx rgba(8, 48, 84, .22);
}

.appointment-copy {
  position: relative;
  z-index: 1;
}

.appointment-kicker,
.appointment-title,
.appointment-summary {
  display: block;
}

.appointment-kicker {
  color: #ffd06f;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.appointment-title {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
}

.appointment-summary {
  max-width: 540rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, .7);
  font-size: 23rpx;
  line-height: 1.65;
}

.appointment-cta {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 82rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0b5975;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 82rpx;
}

.appointment-cta::after {
  border: 0;
}

.appointment-orbit {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 50%;
}

.appointment-orbit-large {
  top: -160rpx;
  right: -110rpx;
  width: 420rpx;
  height: 420rpx;
}

.appointment-orbit-small {
  top: -76rpx;
  right: -26rpx;
  width: 250rpx;
  height: 250rpx;
}
