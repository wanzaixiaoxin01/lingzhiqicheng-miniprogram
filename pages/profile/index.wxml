<view class="page profile-page">
  <view class="profile-header">
    <text class="eyebrow">PARENT CENTER</text>
    <text class="page-title">我的</text>
    <text class="page-summary">查看孩子的报名信息与上课记录</text>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <view class="loading-dot"></view>
    <text class="state-title">正在读取家长信息</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="state-card">
    <text class="state-kicker">LOAD FAILED</text>
    <text class="state-title">{{errorMessage}}</text>
    <button class="state-button" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{dashboard.needs_phone_authorization}}" class="auth-card">
    <text class="auth-index">01</text>
    <text class="auth-kicker">WECHAT VERIFICATION</text>
    <text class="auth-title">授权手机号，查看孩子记录</text>
    <text class="auth-copy">手机号仅用于匹配老师在报名时登记的家长信息，不会向其他用户公开。</text>
    <button
      class="phone-auth-button"
      open-type="getPhoneNumber"
      loading="{{authorizing}}"
      disabled="{{authorizing}}"
      bindgetphonenumber="authorizePhone"
    >微信手机号登录</button>
  </view>

  <block wx:elif="{{dashboard}}">
    <view class="identity-row">
      <view>
        <text class="identity-label">已验证家长手机号</text>
        <text class="identity-phone">{{dashboard.phone_masked}}</text>
      </view>
      <text class="identity-status">已认证</text>
    </view>

    <view wx:if="{{dashboard.students.length}}" class="dashboard-content">
      <scroll-view wx:if="{{dashboard.students.length > 1}}" class="student-switcher" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="student-switcher-inner">
          <button
            wx:for="{{dashboard.students}}"
            wx:key="id"
            class="student-chip {{activeStudentId === item.id ? 'student-chip-active' : ''}}"
            data-student-id="{{item.id}}"
            bindtap="selectStudent"
          >{{item.name}}</button>
        </view>
      </scroll-view>

      <view class="student-card">
        <view class="student-topline">
          <text class="student-label">CURRENT STUDENT</text>
          <text class="student-grade">{{activeStudent.grade}}</text>
        </view>
        <view class="student-main">
          <view>
            <text class="student-name">{{activeStudent.name}}</text>
            <text wx:if="{{activeStudent.school}}" class="student-school">{{activeStudent.school}}</text>
          </view>
          <view class="attendance-total">
            <text class="attendance-number">{{activeStudent.attendance_count}}</text>
            <text class="attendance-unit">累计上课</text>
          </view>
        </view>
      </view>

      <view class="section-block">
        <view class="section-heading">
          <text class="section-kicker">ENROLLMENT</text>
          <text class="section-title">报名信息</text>
        </view>
        <view
          wx:for="{{activeStudent.enrollments}}"
          wx:key="id"
          class="enrollment-card"
        >
          <view class="enrollment-row">
            <text class="field-label">服务点</text>
            <text class="field-value">{{item.campus_name}}</text>
          </view>
          <view class="enrollment-row">
            <text class="field-label">学习方向</text>
            <text class="field-value">{{item.course_title || item.service_type}}</text>
          </view>
        </view>
        <view wx:if="{{!activeStudent.enrollments.length}}" class="inline-empty">暂无有效报名信息</view>
      </view>

      <view class="section-block">
        <view class="section-heading">
          <text class="section-kicker">ATTENDANCE</text>
          <text class="section-title">上课记录</text>
        </view>
        <view class="attendance-timeline">
          <view
            wx:for="{{activeStudent.attendance_records}}"
            wx:key="id"
            class="attendance-item"
          >
            <view class="timeline-mark"><view class="timeline-dot"></view></view>
            <view class="attendance-body">
              <view class="attendance-heading">
                <text class="attendance-date">{{item.attendance_date}}</text>
                <view class="attendance-meta">
                  <text class="attendance-period">{{item.attendance_period_label}}</text>
                  <text class="attendance-campus">{{item.campus_name}}</text>
                </view>
              </view>
              <text class="attendance-course">{{item.course_title || item.service_type}}</text>
              <text wx:if="{{item.note}}" class="attendance-note">{{item.note}}</text>
            </view>
          </view>
          <view wx:if="{{!activeStudent.attendance_records.length}}" class="timeline-empty">
            <text class="empty-title">还没有上课记录</text>
            <text class="empty-copy">老师登记后会显示在这里</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="state-card no-match-card">
      <text class="state-kicker">NO RECORD FOUND</text>
      <text class="state-title">暂未查询到报名信息</text>
      <text class="state-copy">请确认报名预留手机号与当前微信手机号一致，或联系客服处理。</text>
    </view>
  </block>

  <view class="support-actions">
    <button class="support-button support-primary" bindtap="goAppointment">预约体验</button>
    <button class="support-button" bindtap="callService">联系客服</button>
  </view>
</view>
