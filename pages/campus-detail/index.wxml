<view class="page">
  <view class="card campus-card">
    <text class="title">{{campus.name || '校区详情'}}</text>
    <text class="muted">地址：{{campus.address}}</text>
    <text class="muted">电话：{{campus.phone}}</text>
    <text class="muted">营业时间：{{campus.business_hours}}</text>
    <text class="muted">{{campus.intro}}</text>
    <button class="primary-button" bindtap="goAppointment">预约到店</button>
    <button class="ghost-button" bindtap="callCampus">电话咨询</button>
  </view>
</view>
