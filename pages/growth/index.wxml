<view class="page">
  <view wx:if="{{loadingPosters}}" class="poster-state">
    <view class="poster-loading-dot"></view>
    <text>正在加载设备介绍</text>
  </view>

  <view wx:elif="{{marketingImages.length}}" class="poster-stream">
    <image
      wx:for="{{marketingImages}}"
      wx:key="*this"
      class="marketing-image {{index === 0 ? 'marketing-image--first' : ''}}"
      src="{{item}}"
      mode="widthFix"
      lazy-load="{{index > 1}}"
      show-menu-by-longpress="false"
    />
  </view>

  <view wx:else class="poster-state poster-empty">
    <text class="poster-state-kicker">LINGZHI PAD</text>
    <text class="poster-state-title">暂无学习机海报</text>
    <text class="poster-state-copy">可先咨询设备配置与到店体验</text>
  </view>

  <view class="conversion-card">
    <text class="conversion-eyebrow">LINGZHI PAD</text>
    <text class="conversion-title">给孩子一套更懂学习的工具</text>
    <text class="conversion-copy">了解学习机配置、适用年级与购买方案</text>
    <button class="conversion-button" bindtap="goAppointment">立即咨询购买</button>
  </view>

  <view class="purchase-bar">
    <view class="purchase-copy">
      <text class="purchase-title">AI 学习机</text>
      <text class="purchase-subtitle">咨询配置与购买方案</text>
    </view>
    <button class="purchase-button" bindtap="goAppointment">咨询购买</button>
  </view>
</view>
