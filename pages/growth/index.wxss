.page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  box-sizing: border-box;
  background: #eaf3fc;
}

.poster-state {
  min-height: 520rpx;
  padding: 96rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-sizing: border-box;
  color: #718096;
  background: linear-gradient(145deg, #eef5fb, #fff);
}

.poster-loading-dot {
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid rgba(18, 67, 116, .18);
  border-top-color: #124374;
  border-radius: 50%;
  animation: poster-spin .8s linear infinite;
}

.poster-state-kicker { color: #328690; font-size: 22rpx; font-weight: 700; letter-spacing: 6rpx; }
.poster-state-title { color: #10233f; font-size: 40rpx; font-weight: 700; }
.poster-state-copy { font-size: 26rpx; }

@keyframes poster-spin { to { transform: rotate(360deg); } }

.poster-stream {
  overflow: hidden;
  background: #ffffff;
}

.marketing-image {
  display: block;
  width: 100%;
  height: auto;
  margin-top: 12rpx;
  background: #edf5ff;
}

.marketing-image--first {
  margin-top: 0;
}

.conversion-card {
  position: relative;
  overflow: hidden;
  margin: 34rpx 24rpx 0;
  padding: 38rpx 32rpx 32rpx;
  border-radius: 30rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #082650 0%, #0e5375 58%, #168895 100%);
  box-shadow: 0 22rpx 54rpx rgba(8, 48, 84, .22);
}

.conversion-content {
  position: relative;
  z-index: 1;
}

.conversion-eyebrow,
.conversion-title,
.conversion-copy {
  display: block;
}

.conversion-eyebrow {
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #ffd06f;
}

.conversion-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 900;
}

.conversion-copy {
  max-width: 540rpx;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, .7);
}

.conversion-button::after {
  border: 0;
}

.conversion-button {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 82rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 82rpx;
  color: #0b5975;
  background: #ffffff;
}

.conversion-orbit {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 50%;
}

.conversion-orbit-large {
  top: -160rpx;
  right: -110rpx;
  width: 420rpx;
  height: 420rpx;
}

.conversion-orbit-small {
  top: -76rpx;
  right: -26rpx;
  width: 250rpx;
  height: 250rpx;
}
