.page {
  min-height: 100vh;
  padding-bottom: 292rpx;
  box-sizing: border-box;
  background: #eaf3fc;
}

.poster-state {
  min-height: 520rpx;
  padding: 96rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-sizing: border-box;
  color: #718096;
  background: linear-gradient(145deg, #eef5fb, #fff);
}

.poster-loading-dot {
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid rgba(18, 67, 116, .18);
  border-top-color: #124374;
  border-radius: 50%;
  animation: poster-spin .8s linear infinite;
}

.poster-state-kicker { color: #328690; font-size: 22rpx; font-weight: 700; letter-spacing: 6rpx; }
.poster-state-title { color: #10233f; font-size: 40rpx; font-weight: 700; }
.poster-state-copy { font-size: 26rpx; }

@keyframes poster-spin { to { transform: rotate(360deg); } }

.poster-stream {
  overflow: hidden;
  background: #ffffff;
}

.marketing-image {
  display: block;
  width: 100%;
  height: auto;
  margin-top: 12rpx;
  background: #edf5ff;
}

.marketing-image--first {
  margin-top: 0;
}

.conversion-card {
  display: flex;
  flex-direction: column;
  margin: 24rpx 24rpx 0;
  padding: 52rpx 40rpx 44rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #102c5a 0%, #0d61be 62%, #159fd9 100%);
  box-shadow: 0 18rpx 44rpx rgba(22, 71, 129, 0.2);
}

.conversion-eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  color: #7bdaf1;
}

.conversion-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  line-height: 1.35;
  font-weight: 800;
}

.conversion-copy {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.76);
}

.conversion-button,
.purchase-button {
  margin: 0;
  border: 0;
  font-weight: 700;
}

.conversion-button::after,
.purchase-button::after {
  border: 0;
}

.conversion-button {
  width: 100%;
  height: 88rpx;
  margin-top: 34rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  color: #102c5a;
  background: linear-gradient(90deg, #b9f5ff 0%, #ffffff 100%);
}

.purchase-bar {
  position: fixed;
  z-index: 20;
  right: 22rpx;
  bottom: 166rpx;
  left: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 18rpx 18rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  background: rgba(10, 34, 72, 0.94);
  box-shadow: 0 16rpx 42rpx rgba(9, 36, 76, 0.28);
}

.purchase-copy {
  display: flex;
  flex-direction: column;
}

.purchase-title {
  font-size: 29rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #ffffff;
}

.purchase-subtitle {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.62);
}

.purchase-button {
  min-width: 190rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  font-size: 27rpx;
  line-height: 72rpx;
  color: #082752;
  background: linear-gradient(100deg, #7ee9f6 0%, #d9fbff 100%);
}
