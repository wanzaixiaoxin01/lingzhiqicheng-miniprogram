<scroll-view class="self-study-page" scroll-y enhanced show-scrollbar="false">
  <view class="hero">
    <image
      class="hero-image"
      src="../../assets/home/learning-space-interior-v2.jpg"
      mode="aspectFill"
    ></image>
    <view class="hero-shade"></view>

    <view class="hero-topline">
      <view class="hero-brand">
        <image class="hero-logo" src="../../assets/lingzhi-logo-144.png" mode="aspectFit"></image>
        <view>
          <text class="brand-name">灵智启程</text>
          <text class="brand-en">LINGZHI VOYAGE</text>
        </view>
      </view>
      <text class="hero-edition">STUDY SPACE · 2026</text>
    </view>

    <view class="hero-content">
      <text class="hero-kicker">A BETTER PLACE TO LEARN</text>
      <text class="hero-title">AI 智能</text>
      <text class="hero-title hero-title-accent">自习室</text>
      <text class="hero-subtitle">安静、稳定、有陪伴，让孩子真正进入学习状态。</text>

      <view class="hero-features">
        <view class="hero-feature"><text class="feature-index">01</text><text>自习托管</text></view>
        <view class="hero-feature"><text class="feature-index">02</text><text>AI 学习规划</text></view>
        <view class="hero-feature"><text class="feature-index">03</text><text>自主规划</text></view>
      </view>

      <button class="hero-button" bindtap="goAppointment">预约到店体验 <text>→</text></button>
    </view>
  </view>

  <view class="editorial-intro">
    <view class="editorial-index">01 / ABOUT THE SPACE</view>
    <text class="section-title intro-title">把每天的学习，变成看得见的进步</text>
    <text class="section-copy">灵智启程 AI 智能自习室，为孩子提供安静、稳定的自习场地。结合自主规划、设备体验和习惯培养，让每一次专注都有记录。</text>
    <view class="intro-facts">
      <view class="intro-fact"><text class="fact-value">3个</text><text class="fact-label">已开放学习空间</text></view>
      <view class="intro-fact"><text class="fact-value">全程</text><text class="fact-label">学习过程陪伴</text></view>
    </view>
  </view>

  <view class="locations-section">
    <view class="section-heading">
      <view>
        <text class="section-overline">OUR LOCATIONS</text>
        <text class="section-title">离你更近的学习空间</text>
      </view>
    </view>

    <view class="location-list">
      <view class="location-card location-card-{{index}}" wx:for="{{rooms}}" wx:key="id">
        <view class="location-topline">
          <text class="location-index">0{{index + 1}}</text>
          <text class="location-type">LINGZHI STUDY SPACE</text>
        </view>
        <text class="location-name">{{item.name}}</text>
        <view class="location-address">
          <text class="address-label">ADDRESS</text>
          <text class="address-text">{{item.address}}</text>
        </view>
        <view class="location-actions">
          <button class="location-action secondary-action" data-address="{{item.address}}" bindtap="copyAddress">复制地址</button>
          <button class="location-action primary-action" data-phone="{{item.phone}}" bindtap="callRoom">电话咨询 <text>→</text></button>
        </view>
      </view>
    </view>
  </view>

  <view class="services-section">
    <text class="section-overline">WHY LINGZHI</text>
    <text class="section-title">专注学习，也有人陪伴</text>
    <view class="service-grid">
      <view class="service-item">
        <text class="service-number">01</text>
        <text class="service-title">安静托管</text>
        <text class="service-copy">固定学习时段，建立稳定节奏</text>
      </view>
      <view class="service-item">
        <text class="service-number">02</text>
        <text class="service-title">智能规划</text>
        <text class="service-copy">根据学习状态调整每日计划</text>
      </view>
      <view class="service-item">
        <text class="service-number">03</text>
        <text class="service-title">成长反馈</text>
        <text class="service-copy">沉淀学习记录，让阶段成长清晰可见</text>
      </view>
    </view>
  </view>

  <view class="contact-section">
    <text class="contact-kicker">START A BETTER STUDY ROUTINE</text>
    <text class="contact-title">来服务点看看，找到适合孩子的学习节奏</text>
    <button class="contact-button" bindtap="goAppointment">预约到店 <text>→</text></button>
    <view class="contact-rule"></view>
    <view class="hotline-row"><text>联营热线</text><text class="hotline">400-900-6368</text></view>
    <view class="hotline-row"><text>报名热线</text><text class="hotline">188 3952 0239</text></view>
  </view>
</scroll-view>
