.self-study-page {
  height: 100vh;
  box-sizing: border-box;
  background: #f3f0e9;
}

.hero {
  position: relative;
  overflow: hidden;
  height: 850rpx;
  color: #ffffff;
  background: #071a33;
}

.hero-image,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background:
    linear-gradient(180deg, rgba(3, 15, 33, .32) 0%, rgba(3, 15, 33, .1) 24%, rgba(3, 15, 33, .9) 75%, #071a33 100%),
    linear-gradient(90deg, rgba(3, 15, 33, .65) 0%, rgba(3, 15, 33, .08) 78%);
}

.hero-topline,
.hero-content {
  position: relative;
  z-index: 1;
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 36rpx 0;
}

.hero-brand {
  display: flex;
  align-items: center;
}

.hero-logo {
  width: 62rpx;
  height: 62rpx;
  margin-right: 14rpx;
  border: 2rpx solid rgba(255, 255, 255, .7);
  border-radius: 50%;
  background: rgba(255, 255, 255, .94);
}

.brand-name,
.brand-en,
.hero-kicker,
.hero-title,
.hero-subtitle,
.section-title,
.section-copy,
.section-overline,
.location-name,
.service-title,
.service-copy,
.contact-kicker,
.contact-title {
  display: block;
}

.brand-name {
  font-size: 25rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.brand-en {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, .62);
  font-size: 14rpx;
  letter-spacing: 3rpx;
}

.hero-edition {
  color: rgba(255, 255, 255, .62);
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-content {
  position: absolute;
  right: 40rpx;
  bottom: 52rpx;
  left: 40rpx;
}

.hero-kicker {
  color: #e7bd61;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 65rpx;
  font-weight: 900;
  line-height: .92;
  letter-spacing: -2rpx;
}

.hero-title-accent {
  margin-top: 12rpx;
  color: #a9e7e4;
}

.hero-subtitle {
  max-width: 590rpx;
  margin-top: 26rpx;
  color: rgba(255, 255, 255, .78);
  font-size: 25rpx;
  line-height: 1.7;
}

.hero-features {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .2);
}

.hero-feature {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  color: rgba(255, 255, 255, .82);
  font-size: 21rpx;
}

.feature-index {
  margin-right: 7rpx;
  color: #e7bd61;
  font-size: 15rpx;
  font-weight: 900;
}

.hero-button,
.contact-button,
.location-action {
  padding: 0;
  border: 0;
  border-radius: 0;
}

.hero-button::after,
.contact-button::after,
.location-action::after {
  border: 0;
}

.hero-button {
  width: 300rpx;
  height: 76rpx;
  margin: 32rpx 0 0;
  background: #f4e9d0;
  color: #102b4f;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 76rpx;
  letter-spacing: 1rpx;
}

.hero-button text,
.contact-button text,
.primary-action text {
  margin-left: 12rpx;
  color: #b6812f;
}

.editorial-intro {
  position: relative;
  z-index: 2;
  margin: -24rpx 24rpx 0;
  padding: 52rpx 34rpx 40rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #fffdf8;
  box-shadow: 0 18rpx 50rpx rgba(18, 43, 76, .09);
}

.editorial-index,
.section-overline {
  color: #3c7d84;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.section-title {
  margin-top: 14rpx;
  color: #102b4f;
  font-size: 39rpx;
  font-weight: 900;
  line-height: 1.35;
  letter-spacing: -1rpx;
}

.intro-title {
  max-width: 570rpx;
  font-size: 42rpx;
}

.section-copy {
  margin-top: 22rpx;
  color: #67798b;
  font-size: 25rpx;
  line-height: 1.78;
}

.intro-facts {
  display: flex;
  margin-top: 34rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e4ded3;
}

.intro-fact {
  flex: 1;
}

.intro-fact + .intro-fact {
  padding-left: 30rpx;
  border-left: 1rpx solid #e4ded3;
}

.fact-value,
.fact-label {
  display: block;
}

.fact-value {
  color: #b6812f;
  font-size: 36rpx;
  font-weight: 900;
}

.fact-label {
  margin-top: 6rpx;
  color: #7a8792;
  font-size: 20rpx;
}

.locations-section {
  padding: 72rpx 24rpx 64rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 16rpx 26rpx;
}

.location-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 18rpx;
  padding: 32rpx 28rpx 28rpx;
  background: #fffdf8;
  box-shadow: 0 18rpx 50rpx rgba(18, 43, 76, .07);
}

.location-card::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 5rpx;
  background: #b98a3e;
  content: "";
}

.location-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-index {
  color: #b6812f;
  font-size: 19rpx;
  font-weight: 900;
}

.location-type {
  color: #78909a;
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.location-name {
  margin-top: 22rpx;
  color: #102b4f;
  font-size: 36rpx;
  font-weight: 900;
}

.location-address {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e8e2d8;
}

.address-label,
.address-text {
  display: block;
}

.address-label {
  color: #9a8563;
  font-size: 14rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.address-text {
  margin-top: 10rpx;
  color: #5f7182;
  font-size: 24rpx;
  line-height: 1.58;
}

.location-actions {
  display: flex;
  margin-top: 24rpx;
}

.location-action {
  flex: 1;
  height: 68rpx;
  margin: 0 10rpx 0 0;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.location-action:last-child {
  margin-right: 0;
}

.secondary-action {
  background: #ece8df;
  color: #536777;
}

.primary-action {
  background: #102b4f;
  color: #ffffff;
}

.services-section {
  padding: 66rpx 28rpx 72rpx;
  background: #f3f0e9;
}

.services-section > .section-overline,
.services-section > .section-title {
  margin-right: 12rpx;
  margin-left: 12rpx;
}

.service-grid {
  display: flex;
  margin-top: 30rpx;
}

.service-item {
  flex: 1;
  min-width: 0;
  margin-right: 10rpx;
  padding: 24rpx 18rpx 26rpx;
  border-top: 4rpx solid #b98a3e;
  background: #fffdf8;
}

.service-item:last-child {
  margin-right: 0;
}

.service-number {
  color: #b6812f;
  font-size: 16rpx;
  font-weight: 900;
}

.service-title {
  margin-top: 26rpx;
  color: #102b4f;
  font-size: 25rpx;
  font-weight: 900;
}

.service-copy {
  margin-top: 10rpx;
  color: #778490;
  font-size: 20rpx;
  line-height: 1.55;
}

.contact-section {
  padding: 66rpx 40rpx calc(58rpx + env(safe-area-inset-bottom));
  background: #102b4f;
  color: #ffffff;
}

.contact-kicker {
  color: #d8ab59;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.contact-title {
  max-width: 600rpx;
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.42;
}

.contact-button {
  width: 100%;
  height: 80rpx;
  margin: 32rpx 0 0;
  background: #f4e9d0;
  color: #102b4f;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 80rpx;
}

.contact-rule {
  height: 1rpx;
  margin: 38rpx 0 18rpx;
  background: rgba(255, 255, 255, .16);
}

.hotline-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13rpx 0;
  color: rgba(255, 255, 255, .58);
  font-size: 21rpx;
}

.hotline {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
