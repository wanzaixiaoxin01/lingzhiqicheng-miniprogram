<view class="page">
  <view class="page-intro">
    <text class="title">{{pageTitle}}</text>
    <text class="muted">{{pageSummary}}</text>
  </view>
  <block wx:if="{{activeType === 'material'}}">
    <view class="card article-card" wx:for="{{materials}}" wx:key="id" data-id="{{item.id}}" data-kind="material" bindtap="goDetail">
      <text class="title">{{item.title}}</text>
      <text wx:if="{{item.summary}}" class="muted">{{item.summary}}</text>
      <text class="file-meta">{{item.file_name}} · {{item.file_size_label}}</text>
    </view>
    <view wx:if="{{!materials.length}}" class="card empty-card">
      <text class="muted">{{emptyText}}</text>
    </view>
  </block>
  <block wx:else>
    <view class="card article-card" wx:for="{{articles}}" wx:key="id" data-id="{{item.id}}" data-kind="{{activeType}}" bindtap="goDetail">
      <text class="title">{{item.title}}</text>
      <text wx:if="{{item.summary}}" class="muted">{{item.summary}}</text>
    </view>
    <view wx:if="{{!articles.length}}" class="card empty-card">
      <text class="muted">{{emptyText}}</text>
    </view>
  </block>
</view>
