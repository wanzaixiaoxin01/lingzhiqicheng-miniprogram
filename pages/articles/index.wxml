<view class="page">
  <view class="tab-row">
    <text wx:for="{{tabs}}" wx:key="value" data-type="{{item.value}}" bindtap="selectType" class="tab">{{item.label}}</text>
  </view>
  <view class="card article-card">
    <text class="title">内容列表</text>
    <text class="muted">请选择学习资料、教育动态或活动风采</text>
  </view>
  <view class="card article-card" wx:for="{{articles}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <text class="title">{{item.title}}</text>
    <text class="muted">{{item.summary}}</text>
  </view>
</view>
