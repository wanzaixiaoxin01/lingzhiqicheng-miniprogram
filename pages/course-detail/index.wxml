<view class="page">
  <view class="card detail-card">
    <text class="title">{{course.title || '活动详情'}}</text>
    <text class="muted">{{course.summary}}</text>
    <text class="muted">适合年龄：{{course.suitable_grade || '请咨询服务点'}}</text>
    <text class="muted">活动安排：{{course.service_period || '请咨询服务点'}}</text>
    <text class="content">{{course.content}}</text>
    <button class="primary-button" bindtap="goAppointment">预约到店体验</button>
  </view>
</view>
